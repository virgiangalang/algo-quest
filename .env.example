# Copy ke Vercel → Project → Settings → Environment Variables
# Jangan commit file .env yang berisi password asli.

# Wajib — password login halaman /admin.html
ADMIN_PASSWORD=

# Opsional — Google Sheet Credentials (login cepat via CSV export)
# Default sudah mengarah ke Sheet Algonova; ubah jika ganti spreadsheet.
# GOOGLE_SHEET_ID=1cnE2jMYSwEhIM1xCNq9ZRIhM_fFqLJwvCW8YSHsbmdU
# GOOGLE_SHEET_GID=658906218
# CRED_CACHE_MS=20000

# Opsional — Apps Script (hanya untuk SUBMIT hasil / tulis USED)
# APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec

# Publish soal langsung ke Supabase (disarankan)
# Project Settings → API:
#   SUPABASE_URL = Project URL
#   SUPABASE_SERVICE_ROLE_KEY = service_role (rahasia, server-only, jangan ke browser)
#   SUPABASE_ANON_KEY = anon/publishable (opsional kalau service_role sudah ada)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Opsional cadangan — Vercel Blob / GitHub commit
# BLOB_READ_WRITE_TOKEN=
# GITHUB_TOKEN=
# GITHUB_REPO=virgiangalang/algo-quest
# GITHUB_BRANCH=main
