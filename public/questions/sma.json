{"level":"sma","label":"SMA","ageRange":"16–18 tahun","curriculum":"Kurikulum Merdeka","caseTitle":"Operasi Fungsi Rahasia","chapters":[{"id":"bab-1","title":"Bab 1 — Analisis Fungsi","questions":[{"id":"q1-1","scene":"Fungsi tersembunyi di server.","q":"f(x) = 2x² – 3x + 1. Berapa f(2)?","choices":["2","3","4","5"],"answer":1,"skill":"Fungsi","difficulty":"Mudah","type":"analyst","correct":"2(4)–3(2)+1 = 8–6+1 = 3.","wrong":["Substitusi x=2.","3 — tepat!","Hampir.","Terlalu besar."],"clue":"Nilai fungsi di titik kritis: 3."},{"id":"q1-2","scene":"Limit fungsi pada kecepatan data.","q":"lim (x→2) dari (x²–4)/(x–2) = ?","choices":["0","2","4","tidak ada"],"answer":2,"skill":"Limit","difficulty":"Sedang","type":"analyst","correct":"Faktorkan: (x+2)(x–2)/(x–2) = x+2. Limit = 4.","wrong":["Faktorkan pembilang.","Hampir.","4 — tepat!","Limitnya ada."],"clue":"Batas kecepatan data: 4 unit."},{"id":"q1-3","scene":"Turunan untuk cari kecepatan maksimum.","q":"f(x) = 3x² + 2x. Turunannya?","choices":["3x + 2","6x + 2","6x","3x"],"answer":1,"skill":"Kalkulus","difficulty":"Mudah","type":"codebreaker","correct":"f'(x) = 6x + 2.","wrong":["Pakai aturan pangkat.","6x+2 — tepat!","Lupa konstanta.","Lupa koefisien."],"clue":"Fungsi kecepatan: f'(x) = 6x+2."},{"id":"q1-4","scene":"Sudut elevasi antena.","q":"sin 30° + cos 60° = ?","choices":["0","0,5","1","1,5"],"answer":2,"skill":"Trigonometri","difficulty":"Mudah","type":"analyst","correct":"sin 30° = 0,5; cos 60° = 0,5. Total = 1.","wrong":["Nilai sin dan cos 30°/60°.","Hampir.","1 — tepat!","Terlalu besar."],"clue":"Sudut terkonfirmasi: total = 1."},{"id":"q1-5","scene":"Probabilitas enkripsi berhasil.","q":"Dari 100 percobaan, P(berhasil) = 0,7. Perkiraan berhasil?","choices":["50","60","70","80"],"answer":2,"skill":"Statistik","difficulty":"Mudah","type":"investigator","correct":"100 × 0,7 = 70 percobaan.","wrong":["E = n × p.","Hampir.","70 — tepat!","Terlalu besar."],"clue":"Enkripsi berhasil 70 dari 100 kali."}]},{"id":"bab-2","title":"Bab 2 — Operasi Matriks","questions":[{"id":"q2-1","scene":"Matriks kode akses.","q":"Determinan [[2,1],[3,4]] = ?","choices":["4","5","6","7"],"answer":1,"skill":"Matriks","difficulty":"Sedang","type":"codebreaker","correct":"(2×4)–(1×3) = 8–3 = 5.","wrong":["det = ad–bc.","5 — tepat!","Hampir.","Terlalu besar."],"clue":"Kode akses determinan: 5."},{"id":"q2-2","scene":"Persamaan eksponen di sistem.","q":"2ˣ = 32. Berapa x?","choices":["4","5","6","7"],"answer":1,"skill":"Eksponen","difficulty":"Mudah","type":"analyst","correct":"2⁵ = 32. x = 5.","wrong":["2ˣ = 32.","5 — tepat!","2⁶ = 64.","2⁷ = 128."],"clue":"Eksponen kunci: x = 5."},{"id":"q2-3","scene":"Deret aritmetika data enkripsi.","q":"Suku ke-10 dari 3, 7, 11, 15, ... ?","choices":["37","39","41","43"],"answer":1,"skill":"Barisan","difficulty":"Sedang","type":"codebreaker","correct":"a=3, b=4. Suku ke-10 = 3+(9×4) = 39.","wrong":["Suku ke-n = a+(n-1)b.","39 — tepat!","Hampir.","Terlalu besar."],"clue":"Suku ke-10 adalah 39."},{"id":"q2-4","scene":"Luas daerah di bawah kurva.","q":"∫₀² 2x dx = ?","choices":["2","4","6","8"],"answer":1,"skill":"Kalkulus","difficulty":"Sedang","type":"analyst","correct":"[x²]₀² = 4 – 0 = 4.","wrong":["Gunakan teorema fundamental.","4 — tepat!","Hampir.","Terlalu besar."],"clue":"Luas area kritis: 4 satuan."},{"id":"q2-5","scene":"Soal terakhir sebelum kasus terpecahkan.","q":"log₃ 81 = ?","choices":["3","4","5","6"],"answer":1,"skill":"Logaritma","difficulty":"Mudah","type":"codebreaker","correct":"3⁴ = 81. log₃ 81 = 4.","wrong":["3ˣ = 81.","4 — tepat!","3⁵ = 243.","Terlalu besar."],"clue":"Kode akhir: log = 4."}]}]}
