{"level":"dewasa","label":"Dewasa","ageRange":"18+ tahun","curriculum":"Kurikulum Merdeka","caseTitle":"Operasi Numerik Elite","chapters":[{"id":"bab-1","title":"Bab 1 — Keuangan & Logika","questions":[{"id":"q1-1","scene":"Investasi awal Rp5.000.000, bunga majemuk 10%/tahun selama 2 tahun.","q":"Berapa nilai akhir investasi?","choices":["Rp5.500.000","Rp6.000.000","Rp6.050.000","Rp6.100.000"],"answer":2,"skill":"Keuangan","difficulty":"Sedang","type":"analyst","correct":"5.000.000 × (1,1)² = 6.050.000.","wrong":["Bunga majemuk: P(1+r)ⁿ.","Itu bunga sederhana.","6.050.000 — tepat!","Hampir."],"clue":"Nilai investasi: Rp6.050.000."},{"id":"q1-2","scene":"Gaji naik 15% dari Rp4.000.000.","q":"Gaji baru berapa?","choices":["Rp4.400.000","Rp4.500.000","Rp4.600.000","Rp4.700.000"],"answer":2,"skill":"Persentase","difficulty":"Mudah","type":"analyst","correct":"4.000.000 × 1,15 = 4.600.000.","wrong":["Kalikan dengan (1 + 0,15).","Hampir.","4.600.000 — tepat!","Terlalu besar."],"clue":"Gaji baru Rp4.600.000."},{"id":"q1-3","scene":"Data populasi 5 tahun: 200, 220, 242, 266, 293.","q":"Persentase kenaikan dari tahun 1 ke 2?","choices":["5%","10%","15%","20%"],"answer":1,"skill":"Statistik","difficulty":"Mudah","type":"analyst","correct":"(220-200)/200 × 100% = 10%.","wrong":["Kenaikan/nilai awal × 100%.","10% — tepat!","Hampir.","Terlalu besar."],"clue":"Laju pertumbuhan awal: 10%."},{"id":"q1-4","scene":"Logika: semua A adalah B. Semua B adalah C.","q":"Kesimpulan yang pasti benar?","choices":["Semua C adalah A","Semua A adalah C","Sebagian B bukan A","Tidak ada kesimpulan"],"answer":1,"skill":"Logika","difficulty":"Sedang","type":"investigator","correct":"Silogisme: A→B dan B→C maka A→C.","wrong":["C bisa lebih luas.","A⊂B⊂C — tepat!","Salah.","Ada kesimpulan."],"clue":"Rantai logika terkonfirmasi."},{"id":"q1-5","scene":"Break-even: biaya tetap Rp2.000.000, laba per unit Rp50.000.","q":"Berapa unit harus dijual untuk BEP?","choices":["30","35","40","50"],"answer":2,"skill":"Keuangan","difficulty":"Sedang","type":"analyst","correct":"2.000.000 ÷ 50.000 = 40 unit.","wrong":["BEP = biaya tetap ÷ laba per unit.","Hampir.","40 — tepat!","Terlalu banyak."],"clue":"BEP: 40 unit."}]},{"id":"bab-2","title":"Bab 2 — Analisis Lanjutan","questions":[{"id":"q2-1","scene":"Tren data kuartalan: Q1=100, Q2=120, Q3=144.","q":"Q4 jika tumbuh 20% tiap kuartal?","choices":["160","172","172,8","180"],"answer":2,"skill":"Statistik","difficulty":"Sedang","type":"analyst","correct":"144 × 1,2 = 172,8.","wrong":["Kalikan dengan 1,2.","Hampir.","172,8 — tepat!","Terlalu besar."],"clue":"Q4 = 172,8."},{"id":"q2-2","scene":"Modal Rp10.000.000. Produksi: 1000 unit @ Rp8.000. HPP per unit?","choices":["Rp8.000","Rp10.000","Rp18.000","Rp20.000"],"answer":1,"skill":"Keuangan","difficulty":"Sedang","type":"analyst","correct":"(10.000.000 + 8.000.000) ÷ 1000 = 18.000. Modal+biaya produksi dibagi unit.","wrong":["Sertakan biaya modal.","Hampir.","18.000 — tepat!","Terlalu besar."],"clue":"HPP per unit: Rp18.000."},{"id":"q2-3","scene":"Dari 500 pelanggan, 60% pria, 40% wanita. 30% pria beli premium.","q":"Berapa pria yang beli premium?","choices":["60","80","90","100"],"answer":2,"skill":"Statistik","difficulty":"Sedang","type":"analyst","correct":"500 × 0,6 = 300 pria. 300 × 0,3 = 90.","wrong":["Hitung pria dulu, lalu 30% dari pria.","Hampir.","90 — tepat!","Terlalu banyak."],"clue":"90 pria pelanggan premium."},{"id":"q2-4","scene":"ROI = (laba/modal) × 100%. Laba Rp3.000.000, modal Rp15.000.000.","q":"ROI berapa persen?","choices":["15%","20%","25%","30%"],"answer":1,"skill":"Keuangan","difficulty":"Mudah","type":"analyst","correct":"3.000.000/15.000.000 × 100% = 20%.","wrong":["ROI = laba/modal × 100%.","20% — tepat!","Hampir.","Terlalu tinggi."],"clue":"ROI proyek: 20%."},{"id":"q2-5","scene":"Soal penutup kasus.","q":"Jika P(A) = 0,4 dan P(B) = 0,5, dan A,B independen. P(A dan B) = ?","choices":["0,1","0,2","0,3","0,9"],"answer":1,"skill":"Peluang","difficulty":"Sedang","type":"investigator","correct":"P(A∩B) = P(A) × P(B) = 0,4 × 0,5 = 0,2.","wrong":["Kalikan karena independen.","0,2 — tepat!","Terlalu besar.","Itu P(A∪B) bukan P(A∩B)."],"clue":"Peluang gabungan: 0,2."}]}]}
